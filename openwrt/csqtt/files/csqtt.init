#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	/usr/libexec/csqtt/manage prepare || return 1
	client_instance
}
client_instance() {
	[ "$(uci -q get csqtt.main.enabled)" = 1 ] || return 0
	[ -s /var/run/csqtt/client.json ] || return 1
	procd_open_instance client
	procd_set_param command /usr/bin/csqtt-client --config-file /var/run/csqtt/client.json
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/csqtt
	procd_close_instance
}
stop_service() {
	# Stopping transport retains guards, unreachable routes and the DNS service.
	CSQTT_TUN_DEVICE=csqtt0 /usr/libexec/csqtt/tun-hook down
}
reload_service() (
	# A policy edit must not tear down every live VPN allocation. Compare the
	# effective transport config only after the guarded policy apply succeeds.
	umask 077
	old_client=
	trap '[ -z "$old_client" ] || rm -f "$old_client"' EXIT
	trap 'exit 1' HUP INT TERM
	if [ -s /var/run/csqtt/client.json ]; then
		old_client=$(mktemp /var/run/csqtt/reload-client.XXXXXX) || return 1
		cp /var/run/csqtt/client.json "$old_client" || return 1
	fi
	/usr/libexec/csqtt/manage apply >/dev/null || return 1
	if [ "$(uci -q get csqtt.main.enabled)" != 1 ]; then
		stop
		return $?
	fi
	if [ -n "$old_client" ] && cmp -s "$old_client" /var/run/csqtt/client.json &&
		procd_running csqtt client; then
		return 0
	fi
	stop || return 1
	# The policy transaction already generated and validated client.json.
	# Register through rc.common without running prepare a second time.
	rc_procd client_instance
)
service_triggers() {
	procd_add_reload_trigger csqtt
}
