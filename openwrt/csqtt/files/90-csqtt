#!/bin/sh
# Recompute directly connected LAN destinations after netifd changes. Ignore
# csqtt0 itself: its hook only changes the reserved route, never fw4 or WAN.
case "$ACTION" in ifup|ifupdate|ifdown) ;; *) exit 0 ;; esac
[ "$INTERFACE" != csqtt ] || exit 0
[ "$DEVICE" != csqtt0 ] || exit 0
[ ! -f /etc/csqtt/deactivated ] || exit 0
[ -f /etc/csqtt/policy.json ] || exit 0
/usr/libexec/csqtt/manage apply >/dev/null 2>&1 || logger -t csqtt 'Interface policy refresh failed; inspect diagnostics'
