config client 'main'
	option enabled '0'
	# Observation is enabled separately; automatic actions stay opt-in until
	# router acceptance of this preview has passed.
	option auto_recover '0'
	option peer ''
	option password ''
	# The automatic profile starts at the original protocol minimum. Increasing
	# automatic tiers awaits measured platform resource/performance evidence.
	option workers 'auto'
	option obfs 'video'
	option turn_transport 'udp'
	option vk_auth_mode 'vkcalls'
	option fingerprint 'firefox'
	option client_ids '8202606,6287487'
	option captcha_timeout_secs '180'
	option tun_device 'csqtt0'
	option vpn_dns '1.1.1.1'
	option wan_dns '9.9.9.9'
	list lan_device 'br-lan'

# Add group/device/rule sections in LuCI. Empty configuration changes no routes.
