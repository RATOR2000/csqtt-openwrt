#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=09

start_service() {
    local address
    address="$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address')"
    [ -n "$address" ] || return 0
    mkdir -p /var/run/csqtt /etc/csqtt/captcha
    chmod 0700 /var/run/csqtt /etc/csqtt/captcha
    procd_open_instance
    procd_set_param command /usr/bin/csqtt-captcha serve --listen "$address:9443"
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_set_param term_timeout 10
    procd_close_instance
}

service_triggers() { procd_add_interface_trigger "interface.*" lan /etc/init.d/csqtt-captcha restart; }
