#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=09

start_service() {
    local address
    address="$(/usr/libexec/csqtt/manage helper-address 2>/dev/null)"
    [ -n "$address" ] || return 0
    mkdir -p /var/run/csqtt /etc/csqtt/captcha
    chmod 0700 /var/run/csqtt /etc/csqtt/captcha
    procd_open_instance
    procd_set_param command /usr/bin/csqtt-captcha serve --listen "$address:9443"
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_set_param term_timeout 10
    procd_close_instance
}

service_triggers() {
    # Logical interface names differ across vendor firmware and custom LANs.
    procd_add_reload_trigger csqtt
}
